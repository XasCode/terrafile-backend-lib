#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check if detect-secrets is installed
if ! command -v detect-secrets &> /dev/null
then
    echo "Warning: detect-secrets is not installed."
    echo "!!! detect-secrets will not be run."
    exit 0
fi
# Check if pyahocorasick is installed (word-list)
if ! python -c "import ahocorasick" &> /dev/null
then
    echo "Warning: pyahocorasick is not installed."
    echo "!!! detect-secrets will not be run."
    exit 0
fi

WORDLIST_ARG=""
if [ -f wordlist.txt ] && [ -s wordlist.txt ]; then
  if python -c "import ahocorasick" &> /dev/null; then
    WORDLIST_ARG="--word-list wordlist.txt"
  else
    echo "Warning: pyahocorasick is not installed; running without wordlist."
  fi
else
  echo "Warning: wordlist.txt is missing or empty; running without wordlist."
fi

if [ -z "$WORDLIST_ARG" ] && grep -q '"file_name": "wordlist.txt"' .secrets.baseline 2>/dev/null; then
  echo "Rebuilding baseline without wordlist..."
  rm -f .secrets.baseline
fi

cleanup() {
  rm -f .secrets.new
}
trap cleanup EXIT

# if there is no valid baseline, create one
if [ ! -s .secrets.baseline ]; then
    echo "Creating baseline..."
    if [ -n "$WORDLIST_ARG" ]; then
      detect-secrets scan --no-verify $WORDLIST_ARG --all-files . > .secrets.baseline
    else
      detect-secrets scan --no-verify --all-files . > .secrets.baseline
    fi
fi

echo "Running detect-secrets on commit-msg..."
# Scans the commit message.
if [ -n "$WORDLIST_ARG" ]; then
  detect-secrets scan --no-verify $WORDLIST_ARG --string "$@" > /dev/null
else
  detect-secrets scan --no-verify --string "$@" > /dev/null
fi
