#!/usr/bin/env bash
set -euo pipefail

branch=$(git branch --show-current)
if [[ "$branch" == "main" ]]; then
  echo "Error: commits directly on 'main' are blocked." >&2
  exit 1
fi

for tool in detect-secrets jq; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Error: required system command '$tool' is not installed." >&2
    exit 1
  fi
done

WORDLIST_ARG=""
if [ -f wordlist.txt ] && [ -s wordlist.txt ]; then
  if ! command -v python >/dev/null 2>&1 || ! python -c "import ahocorasick" >/dev/null 2>&1; then
    echo "Error: wordlist.txt requires Python and pyahocorasick." >&2
    echo "Install it with: python -m pip install pyahocorasick" >&2
    exit 1
  fi
  WORDLIST_ARG="--word-list wordlist.txt"
fi

if [ -z "$WORDLIST_ARG" ] && grep -q '"file_name": "wordlist.txt"' .secrets.baseline 2>/dev/null; then
  echo "Rebuilding baseline without wordlist..."
  rm -f .secrets.baseline
fi

cleanup() {
  rm -f base.fifo new.fifo .secrets.new
}
trap cleanup EXIT INT TERM

# if there is no valid baseline, create one
if [ ! -s .secrets.baseline ]; then
    echo "Creating baseline..."
    if [ -n "$WORDLIST_ARG" ]; then
      detect-secrets scan --no-verify $WORDLIST_ARG --exclude-files 'node_modules' --all-files . > .secrets.baseline
    else
      detect-secrets scan --no-verify --exclude-files 'node_modules' --all-files . > .secrets.baseline
    fi
fi

# backup the list of known secrets
cp .secrets.baseline .secrets.new

# find all the secrets in the repository
echo "Running detect-secrets on repo..."
if [ -n "$WORDLIST_ARG" ]; then
  detect-secrets scan --no-verify $WORDLIST_ARG --exclude-files 'node_modules' --baseline .secrets.new $(find . -type f ! -name '.secrets.*' ! -path '*/.git*' ! -path '*/node_modules/*') > /dev/null
else
  detect-secrets scan --no-verify --exclude-files 'node_modules' --baseline .secrets.new $(find . -type f ! -name '.secrets.*' ! -path '*/.git*' ! -path '*/node_modules/*') > /dev/null
fi

# if there is any difference between the known and newly detected secrets, break the build
list_secrets() { jq -r '.results | keys[] as $key | "\($key),\(.[$key] | .[] | .hashed_secret)"' "$1" | sort; }

# create named pipes
mkfifo base.fifo
mkfifo new.fifo

# run the list_secrets command
list_secrets .secrets.baseline >base.fifo &
list_secrets .secrets.new >new.fifo &

# compare the two lists
if ! diff new.fifo base.fifo >&2 ; then
  rm -f base.fifo new.fifo .secrets.new
  echo "Detected new secrets in the repo" >&2
  exit 1
fi

# clean up
rm -f base.fifo new.fifo
rm -f .secrets.new
