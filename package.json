{
  "name": "@jestaubach/terrafile-backend-lib",
  "version": "0.1.11",
  "description": "",
  "type": "module",
  "main": "./dist/terrafile-backend-lib.umd.cjs",
  "module": "./dist/terrafile-backend-lib.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/terrafile-backend-lib.js",
      "require": "./dist/terrafile-backend-lib.umd.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run --coverage --reporter dot && npm run test:built",
    "commit": "commit",
    "test:built": "npm run build && node --test __tests__/built-package.smoke.test.mjs",
    "test-all": "vitest run --coverage --reporter dot --config vite-base.config.js",
    "lint": "eslint src --max-warnings 0",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XasCode/terrafile.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/XasCode/terrafile/issues"
  },
  "homepage": "https://github.com/XasCode/terrafile#readme",
  "dependencies": {
    "@jestaubach/cloner-git": "^0.1.14",
    "@jestaubach/fetcher-axios": "^0.1.9",
    "@jestaubach/fs-helpers": "^0.2.31",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vue/language-core": "^3.1.5",
    "@xascode/chalk": "^0.2.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
